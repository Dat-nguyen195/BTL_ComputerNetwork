#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -f "$project_root/scripts/project.py" ]]; then
  echo 'Công cụ scripts/ chỉ có trên máy làm việc local.' >&2
  echo 'Mở mô hình tại simulation/packet-tracer/ hoặc dùng latexmk trong docs/06-report/latex/ để biên dịch báo cáo.' >&2
  exit 1
fi
project_python="$project_root/.venv/bin/python"
if [[ ! -x "$project_python" ]]; then project_python=python3; fi
exec "$project_python" "$project_root/scripts/project.py" "$@"
