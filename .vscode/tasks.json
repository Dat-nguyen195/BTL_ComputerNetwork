{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project: doctor",
      "type": "process",
      "command": "${workspaceFolder}/project",
      "args": [
        "doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Project: check",
      "type": "process",
      "command": "${workspaceFolder}/project",
      "args": [
        "check"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Project: report",
      "type": "process",
      "command": "${workspaceFolder}/project",
      "args": [
        "report"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
