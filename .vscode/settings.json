{
  "latex-workshop.latex.recipes": [
    {"name": "XeLaTeX (Vietnamese report)", "tools": ["hospital-xelatex"]}
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "hospital-xelatex",
      "command": "latexmk",
      "args": ["-xelatex", "-cd", "-interaction=nonstopmode", "-file-line-error", "-halt-on-error", "-outdir=%DIR%/build", "%DOC%"]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.outDir": "%DIR%/build"
}
