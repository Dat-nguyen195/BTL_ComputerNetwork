 parent="1" vertex="1" value="DBP /BHTQ: THIẾT KẾ MỖI SITE - CHƯA NGHIỆM THU" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="30" y="20" width="1340" height="65" as="geometry" /></mxCell><mxCell id="main" parent="1" vertex="1" value="Main WAN gateway&#10;2 leased lines tách biệt; một tuyến/site" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0e7ff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="490" y="120" width="420" height="80" as="geometry" /></mxCell><mxCell id="foot" parent="1" vertex="1" value="Mỗi site:8×48=384 cổng; dùng 277 hiện tại /334 sau tăng trưởng, dư 50.&#10;AP6→8, camera8→10, server2→3 và1 NVR; NVR ghi local. ACL/SSID theo từng site, không kéo VLAN qua WAN." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="30" y="820" width="1340" height="80" as="geometry" /></mxCell><mxCell id="DBP-wan" parent="1" vertex="1" value="DBP: WAN router (lab một node)&#10;Duy nhất một leased line; không có local Internet breakout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0e7ff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="55" y="270" width="590" height="75" as="geometry" /></mxCell><mxCell id="DBP-core" parent="1" vertex="1" value="TẦNG 1 - IT /CCL /MDF&#10;2 distribution dự trù,8 uplink access/core&#10;Server2→3 +NVR1; mỗi NVR≥16 kênh" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#bfdbfe;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="55" y="410" width="590" height="95" as="geometry" /></mxCell><mxCell id="DBP-f1" parent="1" vertex="1" value="TẦNG 1:4 switch /192 cổng&#10;Sau tăng trưởng:156 PC&#10;4 AP+5 camera+3 server+1NVR&#10;169/192 cổng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="55" y="580" width="270" height="120" as="geometry" /></mxCell><mxCell id="DBP-f2" parent="1" vertex="1" value="TẦNG 2: IDF /4 switch&#10;Sau tăng trưởng:156 PC&#10;4 AP+5 camera&#10;1