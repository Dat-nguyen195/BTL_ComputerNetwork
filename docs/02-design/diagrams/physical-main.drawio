ive="1" as="geometry"><Array as="points"><mxPoint x="1120" y="525.0" /><mxPoint x="1120" y="295.0" /></Array></mxGeometry></mxCell><mxCell id="e14" edge="1" parent="1" source="B4" target="core" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#64748b;html=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="385.0" /><mxPoint x="1120" y="295.0" /></Array></mxGeometry></mxCell><mxCell id="e15" edge="1" parent="1" source="B5" target="core" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=none;strokeColor=#64748b;html=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="245.0" /><mxPoint x="1120" y="295.0" /></Array></mxGeometry></mxCell><mxCell id="title" parent="1" vertex="1" value="MAIN: THIẾT KẾ VẬT LÝ - CHƯA KHẢO SÁT / CHƯA HA RUNTIME" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="30" y="20" width="1540" height="65" as="geometry" /></mxCell><mxCell id="note" parent="1" vertex="1" value="A/B: mỗi tòa 5 tầng × 10 phòng; phòng MDF cách tòa 50 m (không phải chiều dài cáp)&#10;20 switch ×48 cổng; PC 600→720, AP 30→40, camera 40→50; còn 150 cổng sau tăng trưởng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="30" y="100" width="1540" height="60" as="geometry" /></mxCell><mxCell id="core" parent="1" vertex="1" value="MDF: 2 CORE L3 (DỰ TRÙ)&#10;Mỗi core: 20 uplink access +8 cổng dịch vụ =28/32&#10;2×40G core-core; HA gateway cần cấu hình/test riêng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#bfdbfe;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="540" y="245" width="520" height="100" as="geometry" /></mxCell><mxCell id="wan" parent="1" vertex="1" value="WAN gateway pair dự trù&#10;2 leased lines→DBP/BHTQ&#10;WAN nối Core, không nối FW" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0e7ff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="545" y="405" width="235" height="95" as="geometry" /></mxCell><mxCell id="fw" parent="1" vertex="1" value="Firewall pair dự trù&#10;Core↔FW↔Internet Edge&#10;ZBF lab một node" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="825" y="405" width="235" height="95" as="geometry" /></mxCell><mxCell id="sf" parent="1" vertex="1" value="2 switch SERVER FARM&#10;VLAN70/90/110&#10;8→10 server nội bộ +NVR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="545" y="565" width="235" height="100" as="geometry" /></mxCell><mxCell id="dmz" parent="1" vertex="1" value="2 switch DMZ RIÊNG&#10;2 server; VLAN80 gateway FW&#10;Không uplink thẳng Core" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="825" y="565" width="235" height="100" as="geometry" /></mxCell><mxCell id="wlc" parent="1" vertex="1" value="2 WLC dự trù&#10;Mỗi WLC hỗ trợ ≥64 AP&#10;AP uplink 1G trong baseline" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="545" y="730" width="235" height="85" as="geometry" /></mxCell><mxCell id="edge" parent="1" vertex="1" value="Edge /2 modem xDSL&#10;PBR/PAT tại Edge&#10;ISP2:8080 công bố DMZ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="825" y="730" width="235" height="85" as="geometry" /></mxCell><mxCell id="foot" parent="1" vertex="1" value="Mỗi IDF có 2 switch; tổng 4 link 10G/IDF (2 link tới mỗi core), tuyến A/B riêng cần khảo sát.&#10;Uplink độc lập/RSTP; chỉ LACP xuyên core khi có một logical switch được cấu hình. GPON: phương án riêng, chưa triển khai." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="30" y="925" width="1540" height="75" as="geometry" /></mxCell><mxCell id="A1" parent="1" vertex="1" value="TÒA A - TẦNG 1: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 phòng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="35" y="755" width="380" height="100" as="geometry" /></mxCell><mxCell id="A2" parent="1" vertex="1" value="TÒA A - TẦNG 2: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 phòng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="35" y="615" width="380" height="100" as="geometry" /></mxCell><mxCell id="A3" parent="1" vertex="1" value="TÒA A - TẦNG 3: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 phòng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="35" y="475" width="380" height="100" as="geometry" /></mxCell><mxCell id="A4" parent="1" vertex="1" value="TÒA A - TẦNG 4: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 phòng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="35" y="335" width="380" height="100" as="geometry" /></mxCell><mxCell id="A5" parent="1" vertex="1" value="TÒA A - TẦNG 5: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 phòng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="35" y="195" width="380" height="100" as="geometry" /></mxCell><mxCell id="B1" parent="1" vertex="1" value="TÒA B - TẦNG 1: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 phòng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=14;"><mxGeometry x="1185" y="755" width="380" height="100" as="geometry" /></mxCell><mxCell id="B2" parent="1" vertex="1" value="TÒA B - TẦNG 2: 1 IDF /2 switch&#10;Sau tăng trưởng:72 PC +4 AP +5 camera&#10;81/96 cổng; Cat6 tới 10 